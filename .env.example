# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> Data API in the Supabase dashboard).
# The anon key is the public client key — safe to embed in the app.
# Never put the service_role key here or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
